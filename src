        .stagger-1 { transition-delay: 0.1s; }
        .stagger-2 { transition-delay: 0.2s; }
        .stagger-3 { transition-delay: 0.3s; }
        
        .word-reveal span { opacity: 0; filter: blur(10px); transition: all 0.5s ease-out; display: inline-block; margin-right: 0.25em; }
