    <script>
        const observerOptions = { threshold: 0.1, rootMargin: "0px 0px -50px 0px" };
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => { if (entry.isIntersecting) entry.target.classList.add('active'); });
        }, observerOptions);
        document.querySelectorAll('.reveal, .word-reveal').forEach(el => observer.observe(el));

        const magnet = document.getElementById('magnet-target');
        const magnetArea = document.querySelector('section');
        if(magnetArea && magnet) {
            magnetArea.addEventListener('mousemove', (e) => {
                const { left, top, width, height } = magnet.getBoundingClientRect();
                const x = e.clientX - (left + width / 2);
                const y = e.clientY - (top + height / 2);
                magnet.style.transform = `translate(${x / 3}px, ${y / 3}px)`;
            });
            magnetArea.addEventListener('mouseleave', () => { magnet.style.transform = `translate(0px, 0px)`; });
        }

        window.addEventListener('scroll', () => {
            const cards = document.querySelectorAll('.project-card');
            cards.forEach((card, index) => {
                const rect = card.getBoundingClientRect();
                const viewportHeight = window.innerHeight;
                if(rect.top < viewportHeight && rect.bottom > 0) {
                    const progress = Math.min(Math.max((viewportHeight - rect.top) / viewportHeight, 0), 1);
                    const scale = 1 - ((cards.length - 1 - index) * 0.02) - (progress * 0.03);
                    card.style.transform = `scale(${scale})`;
                }
            });
        });
    </script>
