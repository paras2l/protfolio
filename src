        .word-reveal.active span:nth-child(1) { transition-delay: 0.1s; }
        .word-reveal.active span:nth-child(2) { transition-delay: 0.2s; }
        .word-reveal.active span:nth-child(3) { transition-delay: 0.3s; }
        .word-reveal.active span:nth-child(4) { transition-delay: 0.4s; }
        .word-reveal.active span:nth-child(5) { transition-delay: 0.5s; }
        .word-reveal.active span:nth-child(6) { transition-delay: 0.6s; }

        .hover-scale { transition: transform 0.2s; }
        .hover-scale:hover { transform: scale(1.05); }
        .project-img { transition: transform 0.7s; }
        .project-card:hover .project-img { transform: scale(1.1); }

